# Copie este arquivo para .env e preencha com os dados do seu Postgres.
#   cp .env.example .env      (ou copiar/colar no Windows)
#
# O .env NÃO vai para o Git (está no .gitignore) porque contém a senha
# do banco. Este .example vai, para que quem clonar o repositório saiba
# quais variáveis precisa criar.
#
# Formato da URL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/oef?schema=public"

# Porta do backend (opcional — o padrão é 3001)
# PORT=3001

# Origem liberada no CORS (opcional — o padrão é http://localhost:3000)
# FRONTEND_URL="http://localhost:3000"
