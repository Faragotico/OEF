# Copie este arquivo para .env e preencha com os dados do seu Postgres.
#   cp .env.example .env      (ou copiar/colar no Windows)
#
# O .env NÃO vai para o Git (está no .gitignore) porque contém a senha
# do banco e o segredo da sessão. Este .example vai, para que quem
# clonar o repositório saiba quais variáveis precisa criar.
#
# Formato da URL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/oef?schema=public"

# Porta do backend (opcional — o padrão é 3001)
# PORT=3001

# Origem liberada no CORS (opcional — o padrão é http://localhost:3000).
# Em produção é obrigatória e tem que ser exata: com o cookie de sessão
# o navegador não aceita origem curinga.
# FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------
# Sessão / login
# ------------------------------------------------------------
# Segredo que assina o token de sessão. OBRIGATÓRIO, mínimo 32
# caracteres — o backend se recusa a subir sem ele. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reaproveite o segredo de outra máquina nem comite o valor real.
JWT_SECRET="cole_aqui_o_valor_gerado"

# Duração da sessão em segundos (opcional — o padrão é 28800, 8 horas)
# JWT_EXPIRES_IN_SECONDS=28800

# ------------------------------------------------------------
# Primeiro usuário — lido por: pnpm exec ts-node prisma/seed-usuario.ts
#
# Rodar o script de novo com o mesmo ADMIN_EMAIL TROCA a senha daquele
# usuário. É o caminho previsto para "esqueci a senha" enquanto não
# existe tela de recuperação.
#
# Atenção: variável já definida no terminal GANHA da que está aqui.
# Se você mudar a senha neste arquivo e não vier o valor novo, limpe a
# do shell antes (PowerShell: Remove-Item Env:ADMIN_SENHA) ou abra um
# terminal novo.
# ------------------------------------------------------------
ADMIN_EMAIL="gestor@email.com.br"
ADMIN_NOME="Nome do Gestor"
ADMIN_SENHA="troque_por_uma_senha_de_verdade"
